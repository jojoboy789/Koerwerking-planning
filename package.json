    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.5.0",
    "framer-motion": "^14.12.0",
    "google-auth-library": "^11.3.2",
    "gsap": "^3.15.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "postprocessing": "^6.39.6",
